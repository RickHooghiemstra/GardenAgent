<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- All remote API traffic uses HTTPS. Media3 RTSP uses its own socket
         stack and is not subject to this config, so no cleartext exception needed. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
